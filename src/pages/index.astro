---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    name: "OwlAuth",
    description:
      "A self-hostable OAuth 2.1 authorization server and user management platform, built in Rust.",
    url: "https://github.com/owlfoundry/owlauth",
  },
];
---

<BaseLayout>
  <section class="intro" aria-labelledby="intro-title">
    <p class="eyebrow">Open source, built in the open</p>
    <h1 id="intro-title">Tools for building dependable software.</h1>
    <p>
      OwlFoundry builds practical open-source infrastructure for developers and
      teams. Our projects are designed to be self-hostable, transparent, and
      straightforward to operate.
    </p>
  </section>

  <section aria-labelledby="projects-title">
    <div class="section-heading">
      <h2 id="projects-title">Projects</h2>
      <span>More to come</span>
    </div>

    <div class="project-list">
      {
        projects.map((project) => (
          <article class="project">
            <div>
              <h3>{project.name}</h3>
              <p>{project.description}</p>
            </div>
            <a href={project.url} aria-label={`View ${project.name} on GitHub`}>
              View project <span aria-hidden="true">&rarr;</span>
            </a>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
