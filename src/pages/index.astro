---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    name: "OwlAuth",
    description:
      "Self-hostable Project Auth and identity infrastructure with isolated projects, upstream OAuth/OIDC providers, and first-party TypeScript, Python, and Rust SDKs.",
    url: "https://github.com/owlfoundry/owlauth",
  },
];
---

<BaseLayout>
  <section class="intro" aria-labelledby="intro-title">
    <p class="eyebrow">Open source, built in the open</p>
    <h1 id="intro-title">Tools for building dependable software.</h1>
    <p class="intro-description">
      OwlFoundry builds practical open-source infrastructure for developers and
      teams. Our projects are designed to be self-hostable, transparent, and
      straightforward to operate.
    </p>
  </section>

  <section aria-labelledby="projects-title">
    <div class="section-heading">
      <h2 id="projects-title">Projects</h2>
      <span>More to come</span>
    </div>

    <div class="project-list">
      {
        projects.map((project) => (
          <article class="project">
            <h3>{project.name}</h3>
            <p class="project-description">{project.description}</p>
            <a
              class="project-link"
              href={project.url}
              aria-label={`View ${project.name} on GitHub`}
            >
              View project <span aria-hidden="true">↗</span>
            </a>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
